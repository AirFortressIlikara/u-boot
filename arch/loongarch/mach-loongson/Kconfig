menu "Loongson platforms"
choice
	prompt "Loongson soc family select"
	depends on TARGET_LOONGSON_2K

config SOC_LS2K300
	bool "Support for LS2K300 family SoCs"
	depends on 64BIT
	select SYS_CACHE_SHIFT_6

endchoice

choice
	prompt "CPU freq select"
	depends on TARGET_LOONGSON_2K

config CPU_500MHZ
	bool "500MHz"

config CPU_600MHZ
	bool "600MHz"

config CPU_700MHZ
	bool "700MHz"

config CPU_800MHZ
	bool "800MHz"
	depends on SOC_LS2K300

config CPU_900MHZ
	bool "900MHz"
	depends on SOC_LS2K300

config CPU_1000MHZ
	bool "1000MHz"
	depends on SOC_LS2K300

config CPU_1100MHZ
	bool "1100MHz"
	depends on SOC_LS2K300
endchoice

config CPU_FREQ
	int
	default 500 if CPU_500MHZ
	default 600 if CPU_600MHZ
	default 700 if CPU_700MHZ
	default 800 if CPU_800MHZ
	default 900 if CPU_900MHZ
	default 1000 if CPU_1000MHZ
	default 1100 if CPU_1100MHZ

endmenu
