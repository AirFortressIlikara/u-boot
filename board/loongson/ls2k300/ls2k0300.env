#ifdef CONFIG_VIDEO
stdin=serial,usbkbd
stdout=serial,vidconsole
stderr=serial,vidconsole
#else
stdin=serial
stdout=serial
stderr=serial
#endif

menucmd=bootmenu
bootmenu_0=Normal boot=boot
bootmenu_1=System boot select=updatemenu bootselect 1
bootmenu_2=Update kernel=updatemenu kernel 1
bootmenu_3=Update rootfs=updatemenu rootfs 1
bootmenu_4=Update u-boot=updatemenu uboot 1
bootmenu_5=Update dtb=updatemenu dtb 1
bootmenu_6=System install or recover=updatemenu system 1
#if !defined(CONFIG_VIDEO)
bootmenu_7=Video resolution select=updatemenu resolution 1
#endif

bootmenu_delay=CONFIG_BOOTDELAY

loadaddr=CONFIG_SYS_LOAD_ADDR
fdt_addr=0x900000000a000000
fdt_size=0xE000
rd_start=0x9000000007000000
rd_size=0x2000000
splashpos=m,m
panel=default
rotate=0
syspart=1
syspart_last=4
syspart_ch=0