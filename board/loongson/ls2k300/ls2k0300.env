#ifdef CONFIG_VIDEO
stdin=serial,usbkbd
stdout=serial,vidconsole
stderr=serial,vidconsole
#else
stdin=serial
stdout=serial
stderr=serial
#endif

menucmd=bootmenu
bootmenu_0=Normal boot=boot
bootmenu_1=Update kernel (uImage) (by tftp)=run update_kernel
bootmenu_2=Update u-boot to spi flash (by tftp)=run update_uboot
bootmenu_3=Update DTB (dtb.bin) to spi flash (by tftp)=run update_dtb
bootmenu_4=System install to mmc device (by tftp)=run recover_system
bootmenu_5=Boot from ramdisk=run boot_ramdisk

bootmenu_delay=CONFIG_BOOTDELAY

loadaddr=CONFIG_SYS_LOAD_ADDR
fdt_addr=0x900000000a000000
fdt_size=0xE000
rd_start=0x9000000007000000
rd_size=0x2000000
splashpos=m,m
panel=default
rotate=0
mmcdev=0
mmcpart=1
kernelimg=uImage
fdt_name=dtb.bin
uboot_name=u-boot-with-spl.bin

download_kernel=tftpboot ${loadaddr} ${kernelimg}
flash_kernel=
	if ext4write mmc ${mmcdev}:${mmcpart} ${loadaddr} /boot/${kernelimg} ${filesize}; then
		echo kernel update succeed;
		else echo kernel update failed;
	fi;
update_kernel=run download_kernel flash_kernel

download_dtb=tftpboot ${loadaddr} ${fdt_name}
flash_dtb=
	sf probe;
	mtd erase dtb;
	sf update ${loadaddr} dtb ${filesize};
update_dtb=run download_dtb flash_dtb

download_uboot=tftpboot ${loadaddr} ${uboot_name}
flash_uboot=
	sf probe;
	mtd erase uboot;
	sf update ${loadaddr} uboot ${filesize};
	mtd erase uboot_env;
	mtd erase ddr_context;
update_uboot=run download_uboot flash_uboot

load_dtb=
	sf probe;
	sf read ${fdt_addr} dtb
download_ramdisk=tftpboot ${rd_start} ramdisk.gz;
prepare_ramdisk=
	run download_ramdisk download_kernel;
	setenv bootargs console=ttyS0,115200 mtdparts=${mtdparts} root=/dev/ram0 init=/linuxrc rw rootfstype=ext2 fbcon=rotate:${rotate} panel=${panel};
prepare_recover_cmdline=setenv bootargs ${bootargs} ins_way=tftp ins_target=mmc u_ip=${ipaddr} u_sip=${serverip};
boot_ramdisk=
	run prepare_ramdisk load_dtb;
	bootm ${loadaddr};
recover_system=
	run prepare_ramdisk prepare_recover_cmdline load_dtb;
	bootm ${loadaddr};
